{
    "name": "mobimend/php-backend",
    "description": "Mobimend Spares — phone repair, wholesale, and retail platform",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Mobimend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mobimend\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
