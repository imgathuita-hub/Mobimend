APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Mobimend/php_backend/public
API_PREFIX=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mobimend
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

AUTH_TOKEN_SECRET=change_this_secret
AUTH_TOKEN_TTL=604800
ADMIN_SETUP_TOKEN=change_this_setup_token

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=mobimendspares@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=mobimendspares@gmail.com
SMTP_FROM_NAME="Mobimend Spares"
WEEKLY_REPORT_RECIPIENTS=management@example.com

ANALYTICS_API_BASE=http://localhost:8001
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=1.0

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-domain.example/php_backend/callback.php
MPESA_RETRY_ATTEMPTS=3
MPESA_CALLBACK_RETRY_ATTEMPTS=3
MPESA_CALLBACK_SIGNATURE_SECRET=
